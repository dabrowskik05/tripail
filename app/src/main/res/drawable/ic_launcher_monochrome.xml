<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon silhouette for Android 13+: the new mark reduced to globe + pin.
  Single flat colour — the system tints it to the wallpaper palette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Globe (matches the adaptive foreground safe-zone circle). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-32,0 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0 Z" />

    <!-- Pin on the upper-right of the globe, hole punched with evenOdd. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M68.5,46 L74,39.2 A6.2,6.2 0 1,0 63,39.2 L68.5,46 Z M65.8,37.5 A2.7,2.7 0 1,0 71.2,37.5 A2.7,2.7 0 1,0 65.8,37.5 Z" />
</vector>
