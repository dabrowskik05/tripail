<?xml version="1.0" encoding="utf-8"?>
<!--
  Tripail's mark: a route crossing a continent, with a pin where it ends.

  Everything sits inside the 66dp safe zone of the 108dp canvas (centre 54,54, radius 33), so no
  adaptive mask — circle, squircle or rounded square — can clip the trail or the pin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Landmass: a soft, abstract coastline rather than any real country. -->
    <path
        android:fillColor="#7FD1B9"
        android:pathData="M33,40 C38,30 52,27 62,31 C72,35 79,33 80,40 C81,48 74,52 72,60 C70,69 60,76 50,74 C40,72 31,66 30,56 C29,48 30,46 33,40 Z" />

    <!-- The travelled route: dashed, because a trail is made of the places you stopped. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M38,66 C44,60 45,53 52,50 C59,47 62,44 63,38" />

    <!-- Start of the journey. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,66 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />

    <!-- Destination pin: the teardrop and its hole. -->
    <path
        android:fillColor="#FF5E7E"
        android:pathData="M63,26 C69,26 74,31 74,37 C74,45 63,55 63,55 C63,55 52,45 52,37 C52,31 57,26 63,26 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,32 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0 Z" />
</vector>
