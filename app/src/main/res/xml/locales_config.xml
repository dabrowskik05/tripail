<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the languages the app ships with, so Android 13+ shows Tripail in the system's
  per-app language picker. Without it the setting exists but is invisible (V3.5.1).
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="pl" />
    <locale android:name="en" />
</locale-config>
